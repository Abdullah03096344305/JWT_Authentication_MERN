<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>DocMate</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div class="w-full h-screen bg-zinc-900 text-white p-10">
    <h1 class="text-3xl font-bold underline p-20">Login Your Account</h1>
    <form method="post" action="/login">
        <input type="email" placeholder="Email" name="email" class="border-2 p-2 m-2 outline-none border-zinc-800"/>
        <input type="password" placeholder="Password" name="password" class="border-2 p-2 m-2 outline-none border-zinc-800"/>
        <button type="submit" class="border p-2 m-2 bg-green-500">Login</button>
    </form>   

</div>
  </body>
</html>